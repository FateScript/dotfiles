_kimi_doctor() {
  local state

  _arguments -C \
    '(--help -h)'{--help,-h}'[Show help]' \
    '1: :->cmds' \
    '*:: :->args'

  case $state in
    cmds)
      _kimi_doctor_subcommands
      ;;

    args)
      case $words[1] in
        config)
          _arguments \
            '(--help -h)'{--help,-h}'[Show help]' \
            '1:Files:_files'
          ;;
        tui)
          _arguments \
            '(--help -h)'{--help,-h}'[Show help]' \
            '1:Files:_files'
          ;;

      esac
      ;;
  esac
}


