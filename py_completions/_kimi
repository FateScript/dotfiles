_kimi() {
  local state

  _arguments -C \
    '(--version -V)'{--version,-V}'[Output the version number]' \
    '(--session --resume -S -r)'{--session,--resume,-S,-r}'[Resume a session (optional id; without id, pick interactively)]:Python Completion:_list_sessions' \
    '(--continue -c)'{--continue,-c}'[Continue the previous session for this directory]' \
    '(--yolo -y)'{--yolo,-y}'[Start in Ask When Needed mode]' \
    '(--auto)'--auto'[Start in Never Ask mode]' \
    '(--model -m)'{--model,-m}'[LLM model alias to use]:Python Completion:_list_models' \
    '(--prompt -p)'{--prompt,-p}'[Run one prompt non-interactively]:prompt:_default' \
    '(--output-format)'--output-format'[Output format for prompt mode]:Choices:(text stream-json)' \
    '*--skills-dir[Load skills from this directory]:Directory:_files -/' \
    '(--agent)'--agent'[Agent profile to start the new session with]:Python Completion:_list_agents' \
    '(--agent-file)'--agent-file'[Load an agent definition from a Markdown file]:Files:_files -g "*.md"' \
    '*--add-dir[Add an additional workspace directory]:Directory:_files -/' \
    '(--plan)'--plan'[Start in plan mode]' \
    '(--help -h)'{--help,-h}'[Show help]' \
    '1: :->cmds' \
    '*:: :->args'

  case $state in
    cmds)
      _kimi_subcommands
      ;;

    args)
      case $words[1] in
        export)
          _arguments \
            '(--output -o)'{--output,-o}'[Output ZIP path]:Files:_files' \
            '(--yes -y)'{--yes,-y}'[Skip previous-session confirmation]' \
            '(--no-include-global-log)'--no-include-global-log'[Skip bundling the global diagnostic log]' \
            '(--help -h)'{--help,-h}'[Show help]' \
            '1:Python Completion:_list_sessions'
          ;;
        fork)
          _arguments \
            '(--cwd)'--cwd'[Working directory used to find the most recent session]:Directory:_files -/' \
            '(--yes -y)'{--yes,-y}'[Skip previous-session confirmation]' \
            '(--help -h)'{--help,-h}'[Show help]' \
            '1:Python Completion:_list_sessions'
          ;;
        provider)
          _kimi_provider
          ;;
        session)
          _kimi_session
          ;;
        acp)
          _arguments \
            '(--login)'--login'[Run device-code login flow then exit]' \
            '(--region)'--region'[Login region used together with --login]:Choices:(mainland-cn global)' \
            '(--help -h)'{--help,-h}'[Show help]'
          ;;
        web)
          _kimi_web
          ;;
        rc)
          _arguments \
            '(--port)'--port'[Bind port (default 58627)]:port:_default' \
            '(--host)'--host'[Bind host (optional value)]:Choices:(127.0.0.1 0.0.0.0 localhost)' \
            '*--allowed-host[Extra allowed Host header]:host:_default' \
            '(--insecure-no-tls)'--insecure-no-tls'[Allow non-loopback bind without TLS proxy]' \
            '(--allow-remote-shutdown)'--allow-remote-shutdown'[Keep remote shutdown route enabled]' \
            '(--dangerous-bypass-auth)'--dangerous-bypass-auth'[Disable bearer-token auth on all routes]' \
            '(--log-level)'--log-level'[Server log level]:Choices:(fatal error warn info debug trace silent)' \
            '(--debug-endpoints)'--debug-endpoints'[Mount /api/v1/debug/* routes]' \
            '(--web-title)'--web-title'[Custom browser tab title]:title:_default' \
            '(--no-open)'--no-open'[Do not open the web UI in the browser]' \
            '(--help -h)'{--help,-h}'[Show help]'
          ;;
        remote)
          _arguments \
            '(--port)'--port'[Bind port (default 58627)]:port:_default' \
            '(--host)'--host'[Bind host (optional value)]:Choices:(127.0.0.1 0.0.0.0 localhost)' \
            '*--allowed-host[Extra allowed Host header]:host:_default' \
            '(--insecure-no-tls)'--insecure-no-tls'[Allow non-loopback bind without TLS proxy]' \
            '(--allow-remote-shutdown)'--allow-remote-shutdown'[Keep remote shutdown route enabled]' \
            '(--dangerous-bypass-auth)'--dangerous-bypass-auth'[Disable bearer-token auth on all routes]' \
            '(--log-level)'--log-level'[Server log level]:Choices:(fatal error warn info debug trace silent)' \
            '(--debug-endpoints)'--debug-endpoints'[Mount /api/v1/debug/* routes]' \
            '(--web-title)'--web-title'[Custom browser tab title]:title:_default' \
            '(--no-open)'--no-open'[Do not open the web UI in the browser]' \
            '(--help -h)'{--help,-h}'[Show help]'
          ;;
        server)
          _kimi_server
          ;;
        vis)
          _arguments \
            '(--port)'--port'[Port to bind (default: auto-pick)]:number:_default' \
            '(--host)'--host'[Host to bind (default: 127.0.0.1)]:Choices:(127.0.0.1 0.0.0.0 localhost)' \
            '(--no-open)'--no-open'[Do not open the browser automatically]' \
            '(--help -h)'{--help,-h}'[Show help]' \
            '1:Python Completion:_list_sessions'
          ;;
        login)
          _arguments \
            '(--help -h)'{--help,-h}'[Show help]'
          ;;
        doctor)
          _kimi_doctor
          ;;
        migrate)
          _arguments \
            '(--help -h)'{--help,-h}'[Show help]'
          ;;
        upgrade)
          _arguments \
            '(--help -h)'{--help,-h}'[Show help]'
          ;;
        update)
          _arguments \
            '(--help -h)'{--help,-h}'[Show help]'
          ;;

      esac
      ;;
  esac
}


