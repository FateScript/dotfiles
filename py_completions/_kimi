    "fork:Fork a session into a new session"
    "provider:Manage LLM providers non-interactively"
    "session:Manage sessions non-interactively"
    "acp:Run as an ACP server over stdio"
    "web:Run the local Kimi server and open the web UI"
    "rc:Run the Kimi server and open the web UI through Remote Control"
    "remote:Alias of rc"
    "server:Deprecated; use kimi web instead"
    "vis:Launch the session visualizer in your browser"
    "login:Authenticate via the device-code flow"
    "doctor:Validate Kimi Code configuration files"
    "migrate:Migrate data from legacy kimi-cli"
    "upgrade:Upgrade Kimi Code to the latest version"
    "update:Alias of upgrade"
