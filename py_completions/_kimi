__list_sessions() {
  python3 -c \
'def list_sessions():
    import json
    from pathlib import Path

    try:
        index = Path("~/.kimi-code/session_index.jsonl").expanduser()
        lines = index.read_text().splitlines()
    except Exception:
        return

    home = str(Path.home())
    seen = set()
    count = 0
    for line in reversed(lines):  # most recent first
        if count >= 100:
            break
        try:
            rec = json.loads(line)
        except Exception:
            continue
        sid = rec.get("sessionId")
        if not sid or sid in seen:
            continue
        seen.add(sid)
        count += 1

        work_dir = rec.get("workDir", "")
        if work_dir.startswith(home):
            work_dir = "~" + work_dir[len(home) :]

        prompt = ""
        session_dir = rec.get("sessionDir")
        if session_dir:
            try:
                state = json.loads((Path(session_dir) / "state.json").read_text())
                prompt = state.get("lastPrompt", "") or ""
            except Exception:
                pass
        prompt = " ".join(prompt.split())[:60]

        desc = f"{work_dir}  {prompt}".strip()
        desc = desc.split("\n")[0].replace(":", "\\:")
        print(f"{sid} {desc}" if desc else sid)

list_sessions()'
} 2>/dev/null

_list_sessions() {
  local -a choices
  local line opt msg

  while IFS= read -r line; do
    opt="${line%% *}"
    msg="${line#* }"
    choices+=("$opt:$msg")
  done < <(__list_sessions)
  _describe -t choices 'choices' choices
}


_kimi_subcommands() {
