# skhd configuration: https://github.com/koekeishiya/skhd
# Syntax: <modifier> - <key> : <command>

# reload this config
cmd + alt - r : skhd --reload

# switch desktop left/right (equivalent to macOS ctrl + left/right)
alt - h : yabai -m space --focus prev
alt - l : yabai -m space --focus next

# focus window by direction (vim-style)
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north

# swap window with neighbor
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# move window to another desktop (space) and follow it
shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4

# toggle floating (a floating window escapes the tiling layout)
alt - f : yabai -m window --toggle float

# launch iTerm2, or switch to it if already running
alt - t : open -a /Applications/iTerm.app

# if VSCode is focused open a new window, otherwise just launch/switch to it
alt - v [
  "Visual Studio Code" : open -na "Visual Studio Code" --args --new-window
  * : open -a "Visual Studio Code"
]

# if Chrome is focused open a new window, otherwise just launch/switch to it
alt - c [
  "Google Chrome" : open -na "Google Chrome" --args --new-window
  * : open -a "Google Chrome"
]

# toggle fullscreen / zoom window to full split area
alt - m : yabai -m window --toggle zoom-fullscreen

# multi-display: focus the recently used display
# (mouse_follows_focus is toggled so the pointer follows and focus sticks)
alt - n : yabai -m config mouse_follows_focus on && \
  yabai -m display --focus recent && \
  yabai -m config mouse_follows_focus off

# multi-display: move window to the other display and follow it
alt - o : yabai -m window --display recent && sleep 0.1 && \
  yabai -m display --focus recent

# resize floating windows
shift + alt - left  : yabai -m window --resize left:-40:0
shift + alt - right : yabai -m window --resize left:40:0
